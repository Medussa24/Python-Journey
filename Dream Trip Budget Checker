# Call the function and print results

total, status = analyze_trip_expenses(paris_expenses, paris_budget)
print(f"Paris Trip -> Total: ${total:.2f} | {status}")

total, status = analyze_trip_expenses(tokyo_expenses, tokyo_budget)
print(f"Tokyo Trip -> Total: ${total:.2f} | {status}")

total, status = analyze_trip_expenses(rome_expenses, rome_budget)
print(f"Rome Trip -> Total: ${total:.2f} | {status}")
